# COMECyT — Variables de Entorno (Plantilla)
# Copiar este archivo como .env y completar los valores
# cp .env.example .env

# ─── Base de Datos (PostgreSQL) ───────────────────────────────────
# Docker: DB_HOST=db  DB_PORT=5432
# Local:  DB_HOST=127.0.0.1  DB_PORT=5432
DB_HOST=db
DB_PORT=5432
DB_NAME=bd_sisibic
DB_USER=CAMBIAR_USUARIO
DB_PASS=CAMBIAR_PASSWORD_SEGURO

# ─── Aplicación ──────────────────────────────────────────────────
UPLOAD_DIR_SOLICITUDES=/var/www/html/public/uploads/solicitudes/
# Generar: openssl rand -hex 32
APP_KEY=CAMBIAR_CLAVE_32_CARACTERES_AQUI
FOLIO_PREFIX=CMCT
# true si el servidor usa HTTPS (activa cookie_secure automáticamente)
APP_HTTPS=false

# ─── Sesiones y Seguridad ────────────────────────────────────────
SESSION_TIMEOUT=7200
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=300

# ─── Groq AI ─────────────────────────────────────────────────────
# Obtener gratis en: https://console.groq.com
GROQ_API_KEY=OBTENER_EN_CONSOLE_GROQ_COM
GROQ_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=600
AI_MAX_CHARS=800

# ─── Email ───────────────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_FROM=noreply@comecyt.gob.mx
MAIL_FROM_NAME=COMECyT Control de Solicitudes

# ─── Cron ────────────────────────────────────────────────────────
CRON_DIAS_UMBRAL=3

# ─── 2FA ─────────────────────────────────────────────────────────
APP_2FA_ENABLED=false
